# PostgreSQL connection string used by Nitro server routes and drizzle-kit.
# Matches the docker-compose.yml service credentials. Port 5434 (5433 is taken
# by the yard-gate reference project).
DATABASE_URL=postgres://dealerportal:dealerportal@localhost:5434/dealerportal

# Server-only session signing secret. The server REFUSES to boot in production
# (NODE_ENV=production) if this is unset or left at the dev default below —
# generate a strong unique value, e.g. `openssl rand -hex 32`.
NUXT_SESSION_SECRET=dev-mitsubishi-dealer-portal-secret-change-me

# Set to 'production' on a real deployment. Enables: secure (HTTPS-only)
# session cookies, HSTS, and disables the /api/auth/seed-demo endpoint.
NODE_ENV=development
